{% extends '@EasyAdmin/page/content.html.twig' %}

{% block content_title %}Starter Back Admin{% endblock %}

{% block main %}
    <section style="display:grid;gap:1rem;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));">
        <article style="padding:1.25rem;border-radius:1rem;background:#0f172a;color:#fff;">
            <h2 style="margin:0 0 .5rem;">Back-office prêt</h2>
            <p style="margin:0;opacity:.82;">Le starter expose un socle admin séparé du flux JWT public.</p>
        </article>
        <article style="padding:1.25rem;border-radius:1rem;background:#fff;border:1px solid #e2e8f0;">
            <h2 style="margin:0 0 .5rem;">Entités éditables</h2>
            <p style="margin:0;color:#475569;">Admins, users, legal documents et billing plans.</p>
        </article>
        <article style="padding:1.25rem;border-radius:1rem;background:#fff;border:1px solid #e2e8f0;">
            <h2 style="margin:0 0 .5rem;">Vues techniques</h2>
            <p style="margin:0;color:#475569;">Outbox, tokens, subscriptions, médias et événements.</p>
        </article>
    </section>
{% endblock %}
